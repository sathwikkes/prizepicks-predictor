# Copy to .env and fill in values. Never commit .env.

# SQLAlchemy database URL. Default is a local SQLite file under data/.
PPP_DATABASE_URL=sqlite:///data/prizepicks.db

# BALLDONTLIE API key (https://www.balldontlie.io). Optional; only needed for
# the live provider adapter. Game-stats endpoints require a paid tier.
PPP_BALLDONTLIE_API_KEY=

# Logging level for the CLI: DEBUG, INFO, WARNING, ERROR
PPP_LOG_LEVEL=INFO
